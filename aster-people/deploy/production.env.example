# Copy to .env.production at the project root. Use unique hexadecimal secrets.
APP_DOMAIN=people.example.com
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Only needed for the one-time bootstrap service.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_14_CHARACTERS
ADMIN_NAME=Administrator
COMPANY_NAME=Your Organization
# Required for access approval and password reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=Your Organization <people@example.com>
MAIL_MESSAGE_DOMAIN=example.com
# Optional document storage settings:
# S3_BUCKET=
# S3_REGION=ap-south-1
