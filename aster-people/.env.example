# Copy locally and supply values privately. Never commit filled environment files.
NODE_ENV=
HOST=
PORT=
APP_ORIGIN=
TRUST_PROXY=
API_INTERNAL_URL=
DATABASE_URL=
REDIS_URL=
DB_PASSWORD=
REDIS_PASSWORD=
APP_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_MESSAGE_DOMAIN=
# Optional document storage; use a scoped AWS IAM credential source.
S3_BUCKET=
S3_REGION=
# One-time bootstrap only: supply ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NAME,
# COMPANY_NAME to the bootstrap process. Never put them in runtime env files.
