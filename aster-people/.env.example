# Copy to .env. Generate unique hexadecimal passwords; never commit .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://daksha:REPLACE_WITH_RANDOM_HEX@127.0.0.1:55433/daksha
REDIS_URL=redis://:REPLACE_WITH_RANDOM_HEX@127.0.0.1:56379
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
# Set NODE_ENV=production only behind HTTPS (session cookies become Secure).
# ADMIN_EMAIL and ADMIN_PASSWORD are only needed by the bootstrap command.
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, MAIL_FROM, MAIL_MESSAGE_DOMAIN
# S3_BUCKET, S3_REGION; use an IAM role in deployment, not static credentials.
