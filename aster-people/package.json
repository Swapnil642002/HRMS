{
  "name": "micromap-daksha",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @daksha/api",
    "dev:web": "npm run dev -w @daksha/web --",
    "build": "npm run build -w @daksha/api && npm run build -w @daksha/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "licenses": "node scripts/license-inventory.mjs",
    "db:push": "node scripts/db-push.mjs",
    "dev:worker": "npm run build -w @daksha/api && node --env-file=.env apps/api/dist/worker.js",
    "test:attendance": "npm run build -w @daksha/api && node --env-file=.env scripts/test-attendance.mjs",
    "test:requests": "npm run build -w @daksha/api && node --env-file=.env scripts/test-requests.mjs",
    "test:security": "npm run build -w @daksha/api && node --test tests/security-http.test.cjs",
    "test:uploads": "npm run build -w @daksha/api && node --test tests/uploads.test.cjs",
    "lint": "eslint .",
    "test:operations": "npm run build -w @daksha/api && node --test tests/operations.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "multer": "2.5.0"
  }
}
